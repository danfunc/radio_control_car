module(name = "radio_control_car", version = "0.1.0")

bazel_dep(name = "platforms", version = "0.0.9")
bazel_dep(name = "bazel_skylib", version = "1.6.1")
bazel_dep(name = "rules_cc", version = "0.0.10")
bazel_dep(name = "pico-sdk", version = "2.2.0")
bazel_dep(name = "shizuku", version = "0.1.0")
bazel_dep(name = "xno", version = "0.1.0") # BLE OTA 本体 (objects/ota)

# clone しただけでビルドできるよう、依存は remote + commit 固定にする。
# Shizuku は BT core (Classic HID host + BLE NUS + 登録し直し) を載せた
# exp/bt-core-classic-20261120 のコミット。
git_override(
    module_name = "shizuku",
    remote = "https://github.com/danfunc/Shizuku.git",
    commit = "205edd7b4b3403d5033a1003c73aa49d3fbd97fd",
)

# BLE OTA (xno::ota) と stage3 (常駐ブートローダ + journal)。
# feat/stage3-journal-20261121 (origin/main 16772bf から分岐)。stage3 は --config=stage3 のときだけ使う。
git_override(
    module_name = "xno",
    remote = "https://github.com/danfunc/XNO.git",
    commit = "2940bd016482905575814bf92cce5269a9a09c60",
)

# 手元で Shizuku / XNO を直しながら開発するときは、gitignore 済みの .bazelrc.user に
#   common --override_module=shizuku=../Shizuku
#   common --override_module=xno=/path/to/XNO
# を書く (git_override より優先される)。

register_toolchains(
    "@pico-sdk//bazel/toolchain:mac-aarch64-rp2350",
    "@pico-sdk//bazel/toolchain:mac-x86_64-rp2350",
    "@pico-sdk//bazel/toolchain:linux-x86_64-rp2350",
    "@pico-sdk//bazel/toolchain:linux-aarch64-rp2350",
)

# picotool (ELF → UF2 変換。//firmware_bazel:car_uf2 が tools として使う)
bazel_dep(name = "picotool", version = "2.2.0")

